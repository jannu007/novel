{
  "name": "製本所 - Markdownから本を作る",
  "short_name": "製本所",
  "description": "Markdownを貼るだけで章・目次・リンクが組まれ、内容に合った表紙と挿絵が付いた本になります。Amazon KDPに出せるEPUB・Word・PDFを、完全無料・通信なしで書き出せます。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f3ea",
  "theme_color": "#1f5f6b",
  "lang": "ja",
  "categories": ["productivity", "books"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/plain",
            "text/markdown",
            "image/*",
            ".md",
            ".markdown",
            ".mdown",
            ".mkd",
            ".txt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdown", ".mkd"],
        "text/plain": [".txt"]
      }
    }
  ]
}
